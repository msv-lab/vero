          ],
          "changes": [
            "Firefox/OpenSSL specs require actual adjacent likelyIssued results before policy acceptance",
            "Chrome validChain additionally runs a Bool helper over all adjacent AKI comparisons; no Spec predicate is called"
          ]
        },
        {
          "nature": "retain_specification_and_intentionally_strengthen_runtime_policy",
          "specs": [
            "spec_firefox_valid_version",
            "spec_openssl_valid_version"
          ],
          "changes": [
            "The existing allExts.isSome -> version=2 conclusion remains unchanged",
